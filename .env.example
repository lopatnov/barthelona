# Copy to .env (gitignored) and fill in only what you use. Loaded by scripts/activate.ps1 / activate.sh.
# Never commit real keys. Missing keys simply disable that provider (config/models.yaml).

# --- Cloud providers (optional) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=             # Alibaba QwenCloud (Qwen3); get a key at home.qwencloud.com/api-keys
# DASHSCOPE_BASE_URL=https://openrouter.ai/api/v1  # override to use OpenRouter instead of QwenCloud

# --- Meterless Nightshift (profile "meterless"); values come from the Nightshift Console ---
# The NVIDIA key does NOT go here: enter it in Nightshift's Providers tab.
METERLESS_RUNTIME_TOKEN=
# METERLESS_BASE_URL=http://127.0.0.1:8088/v1

# --- Local endpoints (defaults shown) ---
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# QDRANT_URL=http://127.0.0.1:6343

# --- Self-hosted off this machine (optional, see config/models.yaml) ---
# LAN_LMSTUDIO_BASE_URL=http://192.168.1.50:1234/v1
# CLOUD_GPU_BASE_URL=https://<host>/v1
# CLOUD_GPU_API_KEY=

# --- Barthelona ---
# BARTHELONA_WORKSPACES=C:\projects\barthelona\workspaces
# BARTHELONA_OTEL=0
