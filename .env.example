# Copy to .env (gitignored) and fill in only what you use. Loaded by scripts/activate.ps1 / activate.sh.
# Never commit real keys. Missing keys simply disable that provider (config/models.yaml).

# --- Cloud providers (optional) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Local endpoints (defaults shown) ---
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# QDRANT_URL=http://127.0.0.1:6333

# --- Barthelona ---
